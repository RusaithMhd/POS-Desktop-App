# ==============================================================================
# TRIWYN POS — CLOUD ENVIRONMENT VARIABLES (Vercel & Supabase)
# Copy this file to .env.local for local testing or configure in Vercel Project Settings
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Official Support WhatsApp Hotlines
NEXT_PUBLIC_SUPPORT_PHONE_1=0770802365
NEXT_PUBLIC_SUPPORT_PHONE_2=0750802353

# (Optional) Custom Desktop Application Download URLs
# If left unset, production falls back to GitHub Releases for RusaithMhd/POS-Desktop-App
# NEXT_PUBLIC_EXE_DOWNLOAD_URL=https://github.com/RusaithMhd/POS-Desktop-App/releases/latest/download/POS-Setup.exe
# NEXT_PUBLIC_ZIP_DOWNLOAD_URL=https://github.com/RusaithMhd/POS-Desktop-App/releases/latest/download/TRIWYN-POS-Complete-Setup-Package.zip


