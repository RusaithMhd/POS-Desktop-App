{
  "name": "triwyn-pos",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "desktop:dev": "concurrently \"next dev -p 3001\" \"wait-on http-get://localhost:3001 && cross-env ELECTRON_START_URL=http://localhost:3001 electron .\"",
    "build": "next build",
    "desktop:build": "next build",
    "desktop:package": "electron-builder",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate:sqlite",
    "db:push": "drizzle-kit push:sqlite"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
